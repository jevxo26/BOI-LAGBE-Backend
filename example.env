# ==================================================
# BOI LAGBE - Backend Environment (EXAMPLE / template)
# Copy this file to `.env` and fill in real values.
# Do NOT commit real secrets here.
# ==================================================

# --- Database (PostgreSQL / Neon) ---
# Connection URL for the platform database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/boi_lagbe?sslmode=require"

# --- JWT / Authentication ---
# Secret used to sign access tokens (15m expiry).
# Use a long, random string (>= 32 chars) in production.
JWT_SECRET="change-me-to-a-long-random-access-token-secret"

# Secret used to sign refresh tokens (7d expiry).
# Use a long, random string (>= 32 chars), different from JWT_SECRET.
JWT_REFRESH_SECRET="change-me-to-a-long-random-refresh-token-secret"

# --- App / Server ---
PORT=4001

# --- Environment Mode ---
# "development" | "production" | "test"
# Controls cookie `secure` flag and OTP debug output in responses.
# Use "production" to require HTTPS cookies and hide OTP debug codes.
NODE_ENV="development"

# --- CORS ---
# Comma-separated list of allowed origins for the admin panel & web client.
# Example: "https://admin.boilagbe.com,https://app.boilagbe.com"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# --- Bootstrap Admin (first-time setup) ---
# Used only by `npm run seed` to create the initial SUPER_ADMIN account.
# Set all three to skip: leave them blank to only seed roles/modules.
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PHONE="+8801700000000"
BOOTSTRAP_ADMIN_PASSWORD="change-me-to-a-strong-admin-password"
